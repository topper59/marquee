[Unit]
Description=Plex Now Playing LED Matrix Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Must start as root for GPIO; the script calls drop_privileges via librgbmatrix
User=root
WorkingDirectory=/opt/plex-matrix
EnvironmentFile=/etc/plex-matrix.env
ExecStart=/opt/plex-matrix/venv/bin/python /opt/plex-matrix/plex_matrix.py
Restart=on-failure
RestartSec=5
# Pin the process to the isolated core (matches isolcpus=3 in cmdline.txt)
CPUAffinity=0 1 2
# Niceness: matrix thread is real-time inside the library, leave nice alone
Nice=-5
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target


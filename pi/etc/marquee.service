[Unit]
Description=Marquee — Plex now-playing LED matrix display
# NetworkManager only, NOT network-online: an unprovisioned device has no
# network to wait for — it must start and bring up its own setup AP.
After=NetworkManager.service

[Service]
Type=simple
# Must start as root for GPIO; the script calls drop_privileges via librgbmatrix
User=root
WorkingDirectory=/opt/marquee
# Config lives in /var/lib/marquee/config.json.
ExecStart=/opt/marquee/venv/bin/python -m marquee
# Creates /var/lib/marquee for config.json
StateDirectory=marquee
Restart=on-failure
RestartSec=5
# Pin the process to the isolated core (matches isolcpus=3 in cmdline.txt)
CPUAffinity=0 1 2
# Niceness: matrix thread is real-time inside the library, leave nice alone
Nice=-5
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
